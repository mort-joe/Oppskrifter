# Copy to .env for local development. Never commit real values.

# --- Browser (bundled by Vite, visible to every user) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (Vercel serverless functions under api/) ---
# Optional: SUPABASE_URL / SUPABASE_ANON_KEY are used if the VITE_ ones are not set on the server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET: bypasses row level security. Only ever set this in Vercel, never in a file that is committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin panel (/admin). All three are SECRET and required; there are no defaults. ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=
